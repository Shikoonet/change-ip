# Linter venv (created by `make lint-bootstrap`) — directory or symlink.
.lint-venv
.lint-venv/

# Local ansible lock directory used by `make ip-rotate-plan`.
.ansible/

# Rotation checkpoint files (runtime state, never source).
state/

# Documentation generation artifacts.
graphify-out/

# Auto-memory.
MEMORY.md
.claude/

# Python build artifacts.
__pycache__/
*.pyc

# Operator-supplied rotation.yml (real server id, real project fingerprint).
# rotation.example.yml is the committed template.
rotation.yml
